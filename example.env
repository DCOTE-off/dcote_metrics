STAGE=development

# Generate a long random value. Docker mounts it into backend and Prometheus;
# it is never baked into either image.
METRICS_AUTH_TOKEN=replace-with-a-long-random-secret
METRICS_ALLOWED_ORIGINS=https://dcote.net,https://www.dcote.net,https://video.dcote.net,http://localhost:7654,http://127.0.0.1:7654
ANALYTICS_RETENTION_DAYS=400

# The public reverse proxy must be able to reach backend and Grafana. Restrict
# these to 127.0.0.1 only when the proxy runs directly on the Docker host.
BACKEND_BIND_ADDRESS=0.0.0.0
PROMETHEUS_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=0.0.0.0

#Grafana 
GF_SECURITY_ADMIN_USER=user
GF_SECURITY_ADMIN_PASSWORD=password

GF_SERVER_ROOT_URL=https://metrics.dcote.net/dashboards
GF_SERVER_SERVE_FROM_SUB_PATH=true
